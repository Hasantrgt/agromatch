# ---------------------------------------------------------------------------
# AGROMATCH — sürüm kontrolüne girmeyecekler
#
# Kural: ÜRETİLEN hiçbir şey depoda durmaz. Depoda yalnızca kaynak bulunur;
# geri kalan her şey tek komutla yeniden üretilir:
#
#     python src/mus_panel_uret.py --hepsi
#
# Üretilen dosyaları depoya koymak iki soruna yol açar: her çalıştırmada
# devasa fark (diff) çıkar, ve bir gün kaynakla çıktı birbirini tutmaz —
# hangisinin doğru olduğu bilinmez.
# ---------------------------------------------------------------------------

# --- Üretilen analiz çıktıları
# Dizinin tamamı dışarıda, ÜÇ ÖZET dosyası hariç. Sebep: panel GitHub
# Pages'te ham laboratuvar verisi olmadan üretiliyor; bu üç dosya
# depoda olmazsa yayındaki panelde "Toprak ölçümü" ve "Veri kalitesi"
# sekmeleri BOŞ çıkar — yani denetimin tamamı görünmez olur.
# Üçü de yalnızca toplam istatistik içerir: n, medyan, çeyrekler,
# denetim sayıları. Tek bir ham kayıt, Lab No ya da köy-ölçüm bağı yok.
# (Negatif kural işlesin diye dizin değil içeriği dışlanıyor: outputs/*)
outputs/*
!outputs/toprak_olcum.json
!outputs/olcum_etkisi.json
!outputs/veri_kalitesi.json
!outputs/toprak_dogrulama.json
!outputs/kil_etkisi.json

# --- Üretilen paneller ve belgeler (kök dizindeki HTML/PDF'ler)
/*.html
/*.pdf

# --- Üretilen sentetik görüntüler ve veri setleri
data/madencilik/
data/sweep/
data/sentetik/
data/goruntu_sentetik/
data/goruntu_bolunmus/
data/saha/

# --- Üretilen grafikler ve belgeler
belgeler/

# --- Üretilen paketler ve föyler
mobil_paket/
foy/
*.zip

# --- Pages yayın klasörü (CI üretir)
yayin/

# --- Model ağırlıkları (büyük ikili dosyalar git'te tutulmaz)
*.pt
*.pth
*.tflite
*.onnx
*.h5

# --- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.Python
build/
dist/

# --- Test ve araç önbellekleri
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node (panel doğrulama betikleri için)
node_modules/
package-lock.json

# --- Düzenleyici ve işletim sistemi
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Gizli bilgi (API anahtarı vb. asla depoya girmez)
.env
*.key
gizli/
# Dışa aktarılan veri paketi — koddan üretilir, depoda durmaz
veri/
# Laboratuvar ham kayitlari — baskasinin verisi, yayimlama izni
# sorulmadan kamuya acik depoya konmaz. Yalnizca ozet istatistikler
# (outputs/toprak_olcum.json) yayimlanir.
data/toprak_analizi/

# SoilGrids ham nokta sorgulari — kodla yeniden uretilir,
# depoda durmaz. Ozeti outputs/toprak_dogrulama.json'da yayimlanir.
data/soilgrids/
